# ============================================
# 清澜山幼儿园课程资源平台 - 环境变量示例
# ============================================
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件已在 .gitignore 中，不要提交真实密钥

# ============================================
# 认证配置
# ============================================

# Session Cookie 名称
SESSION_COOKIE_NAME=qls_session

# Session 过期时间（秒），默认 86400（24小时）
SESSION_TTL_SECONDS=86400

# 是否启用 HTTPS（决定 Cookie 的 Secure 和 SameSite 属性）
# 生产环境必须设为 true，Cookie 将为 Secure; SameSite=None
# 本地开发设为 false，Cookie 将为 SameSite=Lax
HTTPS_ENABLED=false

# ============================================
# 初始账号说明
# ============================================
# 系统启动时自动创建 20 个初始教师账号（幂等）
# 初始密码通过安全渠道单独发放，首次登录强制修改
# 角色：principal / curriculum_director / prek_head / k_head /
#       prek_assistant / k_assistant / pe_specialist
# 详见部署文档 DEPLOYMENT.md

# ============================================
# 日志配置（可选）
# ============================================

# 日志目录
LOG_DIR=./logs

# 是否记录请求/响应体
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
