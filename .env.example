# ============================================
# 清澜山幼儿园课程资源平台 - 环境变量示例
# ============================================
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件已在 .gitignore 中，不要提交真实密钥

# ============================================
# 认证配置
# ============================================

# Session Cookie 名称
SESSION_COOKIE_NAME=qls_session

# Session 过期时间（秒），默认 86400（24小时）
SESSION_TTL_SECONDS=86400

# 是否启用 HTTPS（决定 Cookie 的 Secure 和 SameSite 属性）
# 生产环境必须设为 true，Cookie 将为 Secure; SameSite=None
# 本地开发设为 false，Cookie 将为 SameSite=Lax
HTTPS_ENABLED=false

# ============================================
# 初始账号说明（⚠️ 以下描述已按代码更正）
# ============================================
# 系统启动时自动创建 20 个初始教师账号（幂等，按 username 判存在性）。
#   * 口令哈希**硬编码**在 server/modules/auth/seed-teachers.ts，没有"随机生成"，
#     也**不会**写入启动日志。
#   * **没有强制改密**：must_change_password 在代码中只被赋 false。
#   * 不包含 super_admin，该角色必须另行创建。
#   * seed 失败**不会**阻止进程启动（失败被逐条 catch 并只打日志），
#     因此启动后必须核对日志 `Seed teachers: created=N, skipped=M`。
# 角色：principal / curriculum_director / prek_head / k_head /
#       prek_assistant / k_assistant / pe_specialist
# 详见 DEPLOYMENT_PRODUCTION.md 与 README.md「与旧文档的差异」

# ============================================
# 日志配置（⚠️ 这三个变量代码从不读取，设置无效）
# ============================================
# 保留仅为兼容历史配置。本应用没有文件日志配置，
# Nest Logger 全部写 stdout/stderr，由容器/平台采集。
# 见 DEPLOYMENT_PRODUCTION.md §10。

# 日志目录（无效）
LOG_DIR=./logs

# 是否记录请求/响应体（无效）
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ============================================
# MFA / TOTP（系统超级管理员强制要求）
# ============================================
# TOTP 密钥在数据库中以 AES-256-GCM 加密存储。缺少该密钥时：
#   - 无法开始 MFA 绑定（不会降级为明文存储）
#   - 已启用 MFA 的账号登录会失败关闭（不会静默降级为单因素）
# 生成：openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# ============================================
# 文件下载签名 / 上传校验（Phase 6）
# ============================================
# 下载链接（/api/files/download?token=...）使用 HMAC-SHA256 签名，密钥来自此变量。
# 未配置时服务端**拒绝签发**下载链接（返回 503），不会退化为固定密钥或永久链接。
# 生成：openssl rand -base64 32
DOWNLOAD_TOKEN_SECRET=

# 下载链接有效期（秒），默认 300，硬上限 3600（超过会被钳制）
DOWNLOAD_TOKEN_TTL_SECONDS=300

# 上传大小上限（字节），默认 52428800（50 MB），硬上限 209715200（200 MB）
UPLOAD_MAX_BYTES=52428800

# 回收站保留天数（软删除后多久可被永久清除），默认 30
RESOURCE_RETENTION_DAYS=30

# ============================================
# 反向代理 / 客户端 IP
# ============================================
# 未设置或 false = 不信任任何代理，req.ip 为 socket 地址（安全默认值）
# 反向代理后按实际情况设置，例如：
#   TRUST_PROXY=loopback        （代理在 127.0.0.1，典型 nginx）
#   TRUST_PROXY=1               （恰好一跳可信代理）
#   TRUST_PROXY=10.0.0.0/8      （可信网段）
# ⚠ 设为 true 表示信任所有 X-Forwarded-For，仅在可信代理会覆写该头时使用
TRUST_PROXY=false

# ============================================
# 应用信息（健康检查返回）
# ============================================
APP_VERSION=

# ============================================
# 登录限流（可按环境调整）
# ============================================
# 同一 IP 在窗口内允许的登录尝试次数。
# ⚠ 当前实现为进程内计数：多实例部署时每个副本各自计数，
#   实际上限会乘以副本数。改为共享存储前，这是"刹车"而非硬上限。
LOGIN_IP_RATE_LIMIT_MAX=30
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# 安全响应头
# ---------------------------------------------------------------------------
# Content-Security-Policy 模式：report-only（默认，只上报不拦截）
#                            enforce（真正拦截）| off（关闭）
# 默认 report-only 是刻意的：未经真实构建产物验证的强制 CSP 会导致整站白屏。
# CSP_MODE=report-only
#
# 注意：DOWNLOAD_TOKEN_SECRET / DOWNLOAD_TOKEN_TTL_SECONDS / TRUST_PROXY /
#      HTTPS_ENABLED 均已在上方定义，此处不再重复。
# （同名变量在 .env 中重复定义会产生歧义：后出现的值生效。）
