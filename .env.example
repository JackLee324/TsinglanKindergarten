# ============================================
# 清澜山幼儿园课程资源平台 - 环境变量示例
# ============================================
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件已在 .gitignore 中，不要提交真实密钥

# ============================================
# 认证配置
# ============================================

# Session Cookie 名称
SESSION_COOKIE_NAME=qls_session

# Session 过期时间（秒），默认 86400（24小时）
SESSION_TTL_SECONDS=86400

# 是否启用 HTTPS（决定 Cookie 的 Secure 和 SameSite 属性）
# 生产环境必须设为 true，Cookie 将为 Secure; SameSite=None
# 本地开发设为 false，Cookie 将为 SameSite=Lax
HTTPS_ENABLED=false

# ============================================
# 初始账号说明
# ============================================
# 系统启动时自动创建 20 个初始教师账号（幂等）
# 初始密码通过安全渠道单独发放，首次登录强制修改
# 角色：principal / curriculum_director / prek_head / k_head /
#       prek_assistant / k_assistant / pe_specialist
# 详见部署文档 DEPLOYMENT.md

# ============================================
# 日志配置（可选）
# ============================================

# 日志目录
LOG_DIR=./logs

# 是否记录请求/响应体
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ============================================
# MFA / TOTP（系统超级管理员强制要求）
# ============================================
# TOTP 密钥在数据库中以 AES-256-GCM 加密存储。缺少该密钥时：
#   - 无法开始 MFA 绑定（不会降级为明文存储）
#   - 已启用 MFA 的账号登录会失败关闭（不会静默降级为单因素）
# 生成：openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# ============================================
# 反向代理 / 客户端 IP
# ============================================
# 未设置或 false = 不信任任何代理，req.ip 为 socket 地址（安全默认值）
# 反向代理后按实际情况设置，例如：
#   TRUST_PROXY=loopback        （代理在 127.0.0.1，典型 nginx）
#   TRUST_PROXY=1               （恰好一跳可信代理）
#   TRUST_PROXY=10.0.0.0/8      （可信网段）
# ⚠ 设为 true 表示信任所有 X-Forwarded-For，仅在可信代理会覆写该头时使用
TRUST_PROXY=false

# ============================================
# 应用信息（健康检查返回）
# ============================================
APP_VERSION=

# ============================================
# 登录限流（可按环境调整）
# ============================================
# 同一 IP 在窗口内允许的登录尝试次数。
# ⚠ 当前实现为进程内计数：多实例部署时每个副本各自计数，
#   实际上限会乘以副本数。改为共享存储前，这是"刹车"而非硬上限。
LOGIN_IP_RATE_LIMIT_MAX=30
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# 文件下载签名密钥（Phase 6 私有存储）
# ---------------------------------------------------------------------------
# 下载链接使用 HMAC-SHA256 签名，并与「资源 + 账号」双重绑定、短时过期。
# 未配置时下载链接无法签发，接口会明确返回 503，而不是退化成无签名的长期链接。
# 自行生成（不要复用 MFA 密钥，不要提交到版本库）：
#   openssl rand -base64 32
DOWNLOAD_TOKEN_SECRET=
# 可选：下载链接有效期（秒）。默认 300，硬上限 3600，超出会被截断。
# DOWNLOAD_TOKEN_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# 安全响应头
# ---------------------------------------------------------------------------
# Content-Security-Policy 模式：report-only（默认，只上报不拦截）
#                            enforce（真正拦截）| off（关闭）
# 默认 report-only 是刻意的：未经真实构建产物验证的强制 CSP 会导致整站白屏。
# CSP_MODE=report-only
# 反向代理后必须显式设置，否则客户端 IP 可被 X-Forwarded-For 伪造：
#   TRUST_PROXY=loopback   （或明确的 CIDR）
# 仅在真的由 TLS 终止时才置为 true，它会启用 HSTS：
# HTTPS_ENABLED=false
