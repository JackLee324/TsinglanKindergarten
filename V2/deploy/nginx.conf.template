# V2 反向代理（Nginx）—— 业主 Stage 12 §10/§11/§13/§14
# ============================================================================
# 这个文件是**模板**：官方 nginx 镜像的 entrypoint 会用 envsubst 把
# ${V2_PUBLIC_ORIGIN} / ${STORAGE_ORIGIN} / ${LOGIN_RATE_LIMIT_RPM} / ${LOGIN_RATE_LIMIT_BURST}
# 替换掉，再落到 /etc/nginx/conf.d/default.conf。
#
# 四件事在这里定死：
#   1. 80 端口**只做跳转**，不留任何明文入口（应用不允许 HTTP 登录）；
#   2. 安全响应头（HSTS / XCTO / Referrer-Policy / X-Frame-Options / CSP / Permissions-Policy）；
#   3. 代理头**覆盖**而不是追加：`X-Forwarded-For` / `X-Forwarded-Proto` 由本机重写，
#      客户端自己塞的值一律丢弃（否则"真实 client IP"就是攻击者说了算，限流形同虚设）；
#   4. 登录接口按客户端 IP 限流，超阈值直接 **429**（业务层不加复杂限流器）。

# 限流的键取**真实客户端 IP**（$binary_remote_addr 在覆盖完 XFF 后由 nginx 决定，
# 见下面 real_ip 的配置）。
limit_req_zone $binary_remote_addr zone=login_zone:10m rate=${LOGIN_RATE_LIMIT_RPM}r/m;
limit_req_status 429;
limit_req_log_level warn;

# 登录失败的返回也要在这里能写出 429 的 JSON，前端才看得懂
map $status $rate_limited_body {
  default '';
  429 '{"statusCode":429,"code":"TOO_MANY_REQUESTS","message":"登录尝试过于频繁，请稍后再试。"}';
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # 明文一律跳 HTTPS（含健康检查，避免有人用 http 探活以为通了）
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    # ── TLS ────────────────────────────────────────────────────────────────
    # 本地演练用 deploy/tls 里的自签证书；生产用平台/证书管理器签发的正式证书
    # （同一份配置，只换挂进来的文件）。
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # ── 安全响应头（业主 §13）─────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # CSP：脚本/样式只允许同源；预览要嵌对象存储的 PDF、显示它的图片，所以放行 ${STORAGE_ORIGIN}。
    # 不用 unsafe-inline 放行 script（Vite 产物是外链文件）；style 允许 inline 是因为
    # React 组件的 style 属性（进度条宽度）会生成内联样式。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${STORAGE_ORIGIN}; frame-src 'self' ${STORAGE_ORIGIN}; connect-src 'self' ${STORAGE_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # 代理自己不要泄露版本号（应用侧也关了 x-powered-by）
    server_tokens off;

    client_max_body_size 64m;   # 直传走对象存储，这里只兜底小请求
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # ⚠️ 覆盖，不是追加：客户端伪造的 X-Forwarded-* 到这里被丢弃
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # ── 登录限流（业主 §14：暴力尝试 → 429）──────────────────────────────
    location = /api/auth/login {
        limit_req zone=login_zone burst=${LOGIN_RATE_LIMIT_BURST} nodelay;
        limit_req_status 429;
        error_page 429 = @too_many;
        proxy_pass http://app:3300;
    }

    location @too_many {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"statusCode":429,"code":"TOO_MANY_REQUESTS","message":"登录尝试过于频繁，请稍后再试。"}';
    }

    # ── 应用本体 ───────────────────────────────────────────────────────────
    location / {
        # 健康检查与静态资源都直通应用（同源部署，不需要拆静态站）
        proxy_pass http://app:3300;
    }
}

# ── 对象存储（本地演练用 MinIO；生产是 R2 的公网域名，不走这里）─────────────
# 单独一个 server_name 是有原因的：预签名 URL 的签名覆盖 host + path，
# 用路径前缀去代理会改掉 path、签名直接失效（403）。所以给它独立域名。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name s3.localhost;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 0;      # 上传大小由应用与存储策略决定
    proxy_request_buffering off; # 直传：别把大文件先缓到代理磁盘
    proxy_buffering off;
    proxy_http_version 1.1;
    # ⚠️ 这里必须是 $http_host（带端口），不能用 $host：预签名 URL 的签名覆盖
    # `host:port`，少一个端口就 SigV4 校验失败（403 SignatureDoesNotMatch）。
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://${STORAGE_UPSTREAM};
    }
}
