# V2 反向代理（Nginx）—— 业主 Stage 12 §10/§11/§13/§14
# ============================================================================
# 这个文件是**模板**：官方 nginx 镜像的 entrypoint 会用 envsubst 把
# ${STORAGE_UPSTREAM} 之类的变量替换掉，再落到 /etc/nginx/conf.d/default.conf。
#
# 两件事在这里定死：
#   1. 80 端口**只做跳转**，不留任何明文入口（应用不允许 HTTP 登录）；
#   2. 代理头**覆盖**而不是追加：`X-Forwarded-For` / `X-Forwarded-Proto` 由本机重写，
#      客户端自己塞的值一律丢弃（否则"真实 client IP"就是攻击者说了算，审计与限流都失准）。
#
# ⚠️ 安全响应头与登录失败限流**已经搬到应用里**（`server/common/security-headers.ts`、
#    `server/auth/login-throttle.ts`），这里不再重复：
#      · 2026-10-11 实测发现这两件事以前只由本文件提供，而正式环境（Zeabur）
#        是容器直接对外、没有 Nginx —— 安全头一个都没有、登录没有暴力破解防护，
#        项目自己的 `deploy/verify.mjs` 第 4、7 项必然失败；
#      · 两处同时加 CSP 还有害：浏览器对重复的 CSP 取**交集**，一处放行了对象存储、
#        另一处没放行，就会变成"图片和上传突然都不通"。
#    单一真相放在应用里 —— 前面是 Nginx、Zeabur 网关还是直连，行为都一致。

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # 明文一律跳 HTTPS（含健康检查，避免有人用 http 探活以为通了）
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    # ── TLS ────────────────────────────────────────────────────────────────
    # 本地演练用 deploy/tls 里的自签证书；生产用平台/证书管理器签发的正式证书
    # （同一份配置，只换挂进来的文件）。
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # ── 安全响应头（业主 §13）─────────────────────────────────────────────
    # 由**应用**设置（`server/common/security-headers.ts`）—— 这里不再 add_header，
    # 理由见文件头注释（单一真相 + 避免重复 CSP 取交集）。代理侧只保留不泄露版本号。
    server_tokens off;

    client_max_body_size 64m;   # 直传走对象存储，这里只兜底小请求
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # ⚠️ 覆盖，不是追加：客户端伪造的 X-Forwarded-* 到这里被丢弃
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # ── 应用本体 ───────────────────────────────────────────────────────────
    # 登录限流由应用负责（`server/auth/login-throttle.ts`，生产默认 5 次/分钟、
    # 突发 3，**只数失败**）—— 这里不再 limit_req：不重复实现同一件事。
    location / {
        # 健康检查与静态资源都直通应用（同源部署，不需要拆静态站）
        proxy_pass http://app:3300;
    }
}

# ── 对象存储（本地演练用 MinIO；生产是 R2 的公网域名，不走这里）─────────────
# 单独一个 server_name 是有原因的：预签名 URL 的签名覆盖 host + path，
# 用路径前缀去代理会改掉 path、签名直接失效（403）。所以给它独立域名。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name s3.localhost;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 0;      # 上传大小由应用与存储策略决定
    proxy_request_buffering off; # 直传：别把大文件先缓到代理磁盘
    proxy_buffering off;
    proxy_http_version 1.1;
    # ⚠️ 这里必须是 $http_host（带端口），不能用 $host：预签名 URL 的签名覆盖
    # `host:port`，少一个端口就 SigV4 校验失败（403 SignatureDoesNotMatch）。
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://${STORAGE_UPSTREAM};
    }
}
