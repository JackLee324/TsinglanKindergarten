{
  "name": "qls-v2",
  "version": "2.0.0",
  "private": true,
  "description": "清澜山幼儿园教师资源平台 V2 —— 后端主程序（阶段 2：后端骨架）",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "nest build && vite build --config vite.config.mts",
    "start": "node dist/server/main.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:verify": "node scripts/migrate.mjs verify",
    "seed": "node scripts/seed.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "lint": "eslint server shared scripts tests client/src",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "dev:client": "vite --config vite.config.mts",
    "build:client": "vite build --config vite.config.mts",
    "typecheck:client": "tsc --noEmit --project tsconfig.app.json",
    "typecheck:server": "tsc --noEmit --project tsconfig.node.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.45.3",
    "express": "4.22.3",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^10.4.9",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/postcss": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "postcss": "^8.5.6",
    "vite": "^8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
