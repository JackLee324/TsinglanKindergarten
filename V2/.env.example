# V2 环境变量（复制为 .env 后使用；.env 已被 .gitignore 忽略）
SERVER_PORT=3300
DATABASE_URL=postgresql://qlsadmin:qlsdev_local_only@127.0.0.1:55432/qls_v2_dev

# ── 会话签名与下载签名密钥。必须是 32 字节 base64。 ──────────────────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
V2_SESSION_SECRET=
V2_DOWNLOAD_SECRET=

# ── 文件存储（阶段 6）───────────────────────────────────────────────────────
# local = 开发用（文件放在应用所在的那台机器上）
# s3    = Cloudflare R2 / AWS S3 / MinIO（S3 兼容，生产**必须**用这个）
#
# ⚠️ NODE_ENV=production 且 STORAGE_PROVIDER=local 会**启动即失败**：
#    本地盘重建容器就丢，多实例之间也互相看不见。
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.devdata/storage

# 生产（S3 兼容）填这些。R2 / S3 / MinIO 只有参数不同，业务代码是同一段。
#
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # AWS 用 https://s3.<region>.amazonaws.com
# STORAGE_REGION=auto                                            # R2 填 auto；AWS 填真实 region
# STORAGE_BUCKET=qls-kindergarten-resources
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_FORCE_PATH_STYLE=1                                     # MinIO / 自建通常需要；R2 与 AWS 两者都行

# 上传地址（写）与下载地址（读）的有效期，单位秒。
STORAGE_PUT_TTL_SECONDS=900
STORAGE_GET_TTL_SECONDS=300

# ── 桶的 CORS 与浏览器直传的 Origin ─────────────────────────────────────────
#
# 浏览器直传是跨域 PUT，桶上必须配 CORS，且**只允许正式域名**（绝不要用 *）。
#
# 这个变量只被**写配置**的脚本读（`npm run storage:cors`）；运行时服务不读它。
# 拿它当"检查的期望值"是错的 —— 见下面「域名改了必须重跑检查」。
#
#   V2_PUBLIC_ORIGIN=https://你的域名 npm run storage:cors
V2_PUBLIC_ORIGIN=

# 只读检查（不改任何东西）。期望 Origin 必须**显式给出**：
#
#   npm run storage:check -- --base https://你的部署域名
#   npm run storage:check -- --expected-origin https://你的域名
#
# 不给期望 Origin 时脚本报 BLOCKED 并以退出码 2 结束 —— 不会静默判过。
#
# 退出码：0 通过 · 1 检查未通过（漂移/通配符/方法头缺失/桶不可达）· 2 BLOCKED（缺输入）
#
# ⚠️ 域名改了必须重跑检查。2026-10-12 的真实故障：
#   教师平台换到 tsinglanteachers.zeabur.app，桶的 CORS 还停在旧域名
#   tsinglan.zeabur.app。预检 403 → 浏览器拦掉 PUT → 老师看到「网络中断，上传没有完成」。
#   当时的自检只查通配符，看不出"过期的具体域名"，于是报「正常」。
#
# 出现 `当前实际部署的 Origin 不在允许列表里` 时：
#   1) 先核实期望域名确实是当前在用的那个（看部署平台绑定的域名 / 浏览器地址栏）；
#   2) 确认后，**单独授权**再改配置（写操作不在检查脚本里）：
#        V2_PUBLIC_ORIGIN=<当前域名>[,<其他仍在用的域名>] npm run storage:cors
#   3) 再跑一次只读检查确认通过。
#   允许列表里如果还留着历史域名，检查**只报告不判失败** —— 它可能仍被别的环境用，
#   确认无用之后再单独移除。
