# V2 环境变量（复制为 .env 后使用；.env 已被 .gitignore 忽略）
SERVER_PORT=3300
DATABASE_URL=postgresql://qlsadmin:qlsdev_local_only@127.0.0.1:55432/qls_v2_dev

# 会话 cookie 签名与 CSRF 用的密钥。必须是 32 字节 base64。
V2_SESSION_SECRET=
V2_DOWNLOAD_SECRET=

# 本地开发用文件系统适配器；生产必须为 s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.devdata/storage
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
