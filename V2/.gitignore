# ---- 依赖与构建产物 ----
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo

# ---- 环境与密钥（绝不进 Git）----
.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key

# ---- 本地数据与备份（绝不进 Git）----
.devdata/

# 测试用的真实 S3 后端（SeaweedFS 二进制，~140MB）由 npm run devtools:storage 取回。
# 它是**本机产物**，不进仓库 —— 但在没有它的时候存储集成测试会明确要求先跑那个命令。
.devtools/
backups/
*.ndjson
*.dump
*.sql.gz
storage-local/

# ---- 测试与探针产物 ----
coverage/
.nyc_output/
test-results/
playwright-report/
*.log

# 迁移前后快照（机器相关，且是可重新生成的证据 —— 结论进 docs/V1_RESOURCE_CENSUS.md）
.migration/
